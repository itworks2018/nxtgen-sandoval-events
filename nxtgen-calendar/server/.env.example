# Provided automatically by Render once you attach a Postgres database
DATABASE_URL=postgres://user:password@host:5432/dbname

# Set this to your deployed Vercel URL once you have it, e.g.
# https://nxtgen-sandoval-events.vercel.app
ALLOWED_ORIGIN=*

PORT=3001

# Required in production: long random string used to sign teacher-mode auth
# tokens. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Required: the teacher access code. There is no built-in default anymore —
# teacher mode cannot be unlocked until this is set (or a value is saved to
# the database at kv_store key "nxtgen-sandoval-events:teacher-code").
DEFAULT_TEACHER_CODE=
